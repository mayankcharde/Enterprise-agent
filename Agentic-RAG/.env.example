# LLM API Keys
GROQ_API_KEY=
GOOGLE_API_KEY=your_google_api_key_here

# External Search
TAVILY_API_KEY=

# Vector Database (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb

# LLM Models
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=models/gemini-embedding-001

# Security
ADMIN_API_KEY=

# Application Settings
APP_ENV=development
BACKEND_API_URL=http://127.0.0.1:3000

# LangSmith observability (optional; tracing is disabled by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexadesk-agentic-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Observability privacy controls
OBSERVABILITY_REDACT_INPUTS=true
OBSERVABILITY_REDACT_RETRIEVED_TEXT=true
OBSERVABILITY_REDACTION_PLACEHOLDER=[REDACTED]
EVALUATION_DATASET_NAME=nexadesk-internal-policy-evaluation